PACKAGE_NAME="plxsdk"
PACKAGE_VERSION="#MODULE_VERSION#"
AUTOINSTALL="yes"

MAKE[0]="cd Driver && env PLX_SDK_DIR=${dkms_tree}/${PACKAGE_NAME}/${PACKAGE_VERSION}/build KDIR=${kernel_source_dir} sh -c 'for target in 8000n 8000d 6000n 9050 9030 9080 9054 9056 9656 8311 Svc; do sh ./builddriver \"\$target\" cleanall; sh ./builddriver \"\$target\"; done'"
CLEAN="cd Driver && env PLX_SDK_DIR=${dkms_tree}/${PACKAGE_NAME}/${PACKAGE_VERSION}/build KDIR=${kernel_source_dir} sh -c 'for target in 8000n 8000d 6000n 9050 9030 9080 9054 9056 9656 8311 Svc; do sh ./builddriver \"\$target\" cleanall; done'"

BUILT_MODULE_NAME[0]="Plx8000_NT"
BUILT_MODULE_LOCATION[0]="Driver/Plx8000_NT"
DEST_MODULE_LOCATION[0]="/updates/dkms"

BUILT_MODULE_NAME[1]="Plx8000_DMA"
BUILT_MODULE_LOCATION[1]="Driver/Plx8000_DMA"
DEST_MODULE_LOCATION[1]="/updates/dkms"

